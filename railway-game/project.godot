; Indian Railway Open World - Android prototype
config_version=5

[application]
config/name="Indian Railway Open World"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Indian railway open-world train driving prototype"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=1
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.58, 0.76, 0.91, 1)

[physics]
3d/default_gravity=9.8
